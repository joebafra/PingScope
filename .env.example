# Copy to .env and adjust, or run ./install.sh which writes this file for you.

# Your own hostname for PingScope. Its DNS A (and AAAA) record must point to this server.
PINGSCOPE_DOMAIN=ping.example.nl
# Email for Let's Encrypt (expiry notices). Optional but recommended.
ACME_EMAIL=you@example.nl

# "https" starts Caddy for HTTPS on ports 80/443. Leave empty to run without HTTPS.
COMPOSE_PROFILES=https

# With HTTPS keep PingScope on 127.0.0.1 (only Caddy can reach it).
# Without HTTPS use 0.0.0.0 and open http://<server>:8080
PINGSCOPE_LISTEN=127.0.0.1
PINGSCOPE_PORT=8080

TZ=Europe/Amsterdam

# Optional: Lettermint API token for alert emails. You can also enter it in Admin → Settings → Notifications.
# LETTERMINT_TOKEN=
# Optional: Telegram bot token for alerts (also possible in Admin → Settings → Notifications).
# TELEGRAM_BOT_TOKEN=
# Optional: Pushover application token for alerts (also possible in Admin → Settings → Notifications).
# PUSHOVER_TOKEN=
